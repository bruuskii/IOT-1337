# -*- mode: ruby -*-
# vi: set ft=ruby :

require "fileutils"
require "securerandom"

LOGIN     = "izouine"
SERVER_IP = "192.168.56.110"
WORKER_IP = "192.168.56.111"

# Official Fedora Cloud box, published by the distribution itself (not the
# HashiCorp registry). The checksum pins the exact image that was validated.
# Fedora targets baseline x86-64, so it boots under nested virtualization even
# when the CPU features required by EL10 (x86-64-v3: FMA, F16C) are hidden.
BOX_NAME   = "fedora-45-cloud-official"
BOX_URL    = "https://download.fedoraproject.org/pub/fedora/linux/releases/45/Cloud/" \
             "x86_64/images/Fedora-Cloud-Base-Vagrant-VirtualBox-45-1.4.x86_64.vagrant.virtualbox.box"
BOX_SHA256 = "19635c83a2b4f78b9cc04ac57aee9677f96ea5cb4f88938b9374b82d92c0bfa8"

# One random cluster token per checkout, shared by both nodes. It lives in the
# git-ignored .vagrant directory, so no secret is committed and no synced
# folder is needed to pass it from the server to the worker.
TOKEN_FILE = File.join(__dir__, ".vagrant", "k3s-token")
unless File.exist?(TOKEN_FILE)
  FileUtils.mkdir_p(File.dirname(TOKEN_FILE))
  File.write(TOKEN_FILE, SecureRandom.hex(32))
end
K3S_TOKEN = File.read(TOKEN_FILE).strip

NODES = [
  # The server runs the whole control plane: under nested virtualization one
  # CPU is not enough (health checks time out, system pods restart in loops).
  # The agent only runs the kubelet and stays at the advised single CPU.
  { name: "#{LOGIN}S",  ip: SERVER_IP, cpus: 2, script: "scripts/server.sh" },
  { name: "#{LOGIN}SW", ip: WORKER_IP, cpus: 1, script: "scripts/agent.sh" },
].freeze

Vagrant.configure("2") do |config|
  config.vm.box                        = BOX_NAME
  config.vm.box_url                    = BOX_URL
  config.vm.box_download_checksum      = BOX_SHA256
  config.vm.box_download_checksum_type = "sha256"
  config.vm.box_check_update           = false

  # The official box ships without VirtualBox Guest Additions: provisioning
  # scripts are uploaded over SSH instead of through a shared folder.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Vagrant gives the private interface a gateway (192.168.56.1) whose route
  # outranks the NAT one, cutting the VM off from the internet. Keep the
  # private network for cluster traffic only. Runs before the node scripts.
  config.vm.provision "shell", name: "private-net-no-default-route", inline: <<-SHELL
    set -eu
    # Vagrant writes the connection file via /tmp, so it keeps a tmp SELinux
    # label and NetworkManager may not rewrite it: restore the right label.
    restorecon -R /etc/NetworkManager/system-connections 2>/dev/null || true
    for dev in $(nmcli -g DEVICE,TYPE dev | awk -F: '$2=="ethernet"{print $1}'); do
      ip -4 addr show "$dev" | grep -q 'inet 192\.168\.56\.' || continue
      con=$(nmcli -g GENERAL.CONNECTION dev show "$dev")
      nmcli con modify "$con" ipv4.gateway "" ipv4.never-default yes
      nmcli con up "$con" >/dev/null
    done
    curl -sfI --max-time 15 https://get.k3s.io >/dev/null || { echo "No internet access from the VM" >&2; exit 1; }
  SHELL

  NODES.each do |node|
    config.vm.define node[:name] do |machine|
      machine.vm.hostname = node[:name]
      machine.vm.network "private_network", ip: node[:ip]

      machine.vm.provider "virtualbox" do |vb|
        vb.name   = node[:name]
        vb.cpus   = node[:cpus]
        vb.memory = 1024
        # The box declares "Other Linux", which leaves the I/O APIC off.
        # Under nested virtualization that makes interrupts costly enough to starve
        # K3s on a single CPU. The KVM paravirtual clock is kept off: nested, it
        # returns garbage time and the kernel hangs at boot.
        vb.customize ["modifyvm", :id, "--ostype", "Fedora_64",
                      "--paravirtprovider", "none", "--ioapic", "on"]
      end

      machine.vm.provision "shell", path: node[:script], env: {
        "K3S_TOKEN" => K3S_TOKEN,
        "SERVER_IP" => SERVER_IP,
        "NODE_IP"   => node[:ip],
      }
    end
  end
end
