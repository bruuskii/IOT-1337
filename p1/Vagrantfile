# -*- mode: ruby -*-
# vi: set ft=ruby :

  Vagrant.configure("2") do |config|
    config.vm.define "izouineS" do |izouineS|
      izouineS.vm.box = "bento/ubuntu-24.04"
      izouineS.vm.box_architecture = "arm64"
      izouineS.vm.hostname = "izouineS"
      izouineS.vm.network "private_network", ip: "192.168.56.110"
      izouineS.vm.provider "virtualbox" do |vb|
        vb.memory = "1024"
        vb.cpus = 1
      end
      izouineS.vm.provision "shell", path: "./Controller.sh"
    end
    config.vm.define "izouineSW" do |izouineSW|
      izouineSW.vm.box = "bento/ubuntu-24.04"
      izouineSW.vm.box_architecture = "arm64"
      izouineSW.vm.hostname = "izouineSW"
      izouineSW.vm.network "private_network", ip: "192.168.56.111"
      izouineSW.vm.provider "virtualbox" do |vb|
        vb.memory = "1024"
        vb.cpus = 1
      end
      izouineSW.vm.provision "shell", path: "./Agent.sh"
    end
end
